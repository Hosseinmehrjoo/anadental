# Protect sensitive files (Apache 2.4+)
<IfModule mod_authz_core.c>
  <FilesMatch "^(config\.php|config\.sample\.php|installed\.lock|install\.sql|install-seed\.sql)$">
    Require all denied
  </FilesMatch>
</IfModule>

# Apache 2.2 fallback
<IfModule !mod_authz_core.c>
  <FilesMatch "^(config\.php|config\.sample\.php|installed\.lock|install\.sql|install-seed\.sql)$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>
